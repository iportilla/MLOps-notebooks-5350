# Copy this file to .env and fill in your values:
#     cp env.sample .env
# .env is git-ignored, so your IDs never end up in the repository.
# Find them in the Azure portal (your workspace > Overview) or with:
#     az ml workspace show --name ml_5350 --resource-group <rg> --query id

SUBSCRIPTION_ID = "<your-subscription-id>"
RESOURCE_GROUP = "<your-resource-group>"
WORKSPACE = "ml_5350"
